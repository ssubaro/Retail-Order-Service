                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('tiene id y sku', () => { pm.expect(body.id).to.be.a('number'); pm.expect(body.sku).to.be.a('string'); });",
                  "pm.test('stock y active correctos', () => { pm.expect(body.stock).to.eql(7); pm.expect(body.active).to.eql(true); });",
