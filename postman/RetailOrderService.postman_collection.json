            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"SKU-001-{{runId}}\",\n  \"name\": \"Teclado Mecanico\",\n  \"description\": \"Teclado RGB\",\n  \"price\": 799.90,\n  \"stock\": 7,\n  \"category\": \"Electronica\"\n}"
